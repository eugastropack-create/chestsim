{
  "entities": {
    "global_stats": {
      "title": "Global Statistics",
      "description": "Aggregated real-time global click counts and game events across all players",
      "properties": {
        "totalClicks": {
          "type": "number",
          "description": "Total cumulative clicks on Baron Nashor worldwide"
        },
        "totalKills": {
          "type": "number",
          "description": "Total Baron Nashor eliminations worldwide"
        },
        "totalChestsOpened": {
          "type": "number",
          "description": "Total Hextech chests opened"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last click batch update"
        }
      },
      "required": ["totalClicks"]
    },
    "leaderboard": {
      "title": "Leaderboard Ranking",
      "description": "Player scores, clicks, and rankings",
      "properties": {
        "playerId": {
          "type": "string",
          "description": "Unique identifier for player"
        },
        "summonerName": {
          "type": "string",
          "description": "Summoner name displayed in rankings"
        },
        "clicks": {
          "type": "number",
          "description": "Total clicks performed by player"
        },
        "baronKills": {
          "type": "number",
          "description": "Total Barons slain"
        },
        "chestsOpened": {
          "type": "number",
          "description": "Chests opened count"
        },
        "skinsUnlocked": {
          "type": "number",
          "description": "Permanent skins owned count"
        },
        "lastActive": {
          "type": "string",
          "format": "date-time",
          "description": "Last activity timestamp"
        }
      },
      "required": ["playerId", "summonerName", "clicks"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /global_stats/{statId} {\n      allow read, write: if true;\n    }\n    match /leaderboard/{userId} {\n      allow read, write: if true;\n    }\n    match /player_stats/{playerId} {\n      allow read, write: if true;\n    }\n  }\n}"
}
